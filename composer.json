{
    "name": "rewardgate/reward-gate",
    "type": "project",
    "autoload": {
        "psr-4": {
            "RewardGate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RewardGate\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "robmorgan/phinx": "^0.16",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit tests/Unit",
        "test:integration": "phpunit tests/Integration"
    }
}
